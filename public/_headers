/media/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/dashboard/*
  X-Robots-Tag: noindex, nofollow
/account/*
  X-Robots-Tag: noindex, nofollow
/checkin/*
  X-Robots-Tag: noindex, nofollow
/cms-preview/*
  X-Robots-Tag: noindex, nofollow
/invoice/*
  X-Robots-Tag: noindex, nofollow
/contract/*
  X-Robots-Tag: noindex, nofollow
/client-gallery/*
  X-Robots-Tag: noindex, nofollow
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
