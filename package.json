{
  "name": "tplum-photography",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "node scripts/sync-shared.mjs && node scripts/fetch-cms.mjs && vite build && node scripts/postbuild.mjs",
    "preview": "wrangler pages dev dist/client --port 4173",
    "deploy": "npm run build && wrangler pages deploy dist/client --project-name tplumphotography",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/sync-shared.mjs && vitest run",
    "capture": "node scripts/capture/capture-site.mjs && node scripts/capture/capture-api.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "client-zip": "^2.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "exifr": "^7.1.3",
    "framer-motion": "^14.12.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.71.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.5",
    "react-photo-album": "^3.6.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "yet-another-react-lightbox": "^3.33.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cheerio": "^1.2.0",
    "lighthouse": "^13.6.0",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vite-tsconfig-paths": "^6.1.1",
